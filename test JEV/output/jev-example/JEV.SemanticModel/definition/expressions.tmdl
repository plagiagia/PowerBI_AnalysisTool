expression 'Transform Sample File (2)' = ```
		let
		    Source = Pdf.Tables(Parameter2, [Implementation="1.3"]),
		    // Filter to include only page data rows
		    #"Filtered Rows1" = Table.SelectRows(Source, each Text.Contains([Id], "Page")),
		    // Expand the Data column into individual columns
		    #"Expanded Data" = Table.ExpandTableColumn(#"Filtered Rows1", "Data", {"Column1", "Column2", "Column3", "Column4", "Column5", "Column6"}, {"Data.Column1", "Data.Column2", "Data.Column3", "Data.Column4", "Data.Column5", "Data.Column6"}),
		    
		    // Add page numbers for reference
		    #"Added Page Number" = Table.AddColumn(#"Expanded Data", "PageNum", each if Text.Contains([Id], "Page") then Text.Range([Id], 4, 3) else null, type text),
		    #"Changed Type1" = Table.TransformColumnTypes(#"Added Page Number",{{"Data.Column2", type date}}),
		    #"Renamed Columns3" = Table.RenameColumns(#"Changed Type1",{{"Data.Column2", "Date"}}),
		    
		    #"Changed Type with Locale" = Table.TransformColumnTypes(#"Renamed Columns3", {{"Data.Column5", type number}}, "en-DE"),
		    #"Changed Type with Locale1" = Table.TransformColumnTypes(#"Changed Type with Locale", {{"Data.Column6", type number}}, "en-DE"),
		    #"Added Conditional Column" = Table.AddColumn(#"Changed Type with Locale1", "Amount", each if [Data.Column5] = null then [Data.Column6] else [Data.Column5]),
		    #"Renamed Columns" = Table.RenameColumns(#"Added Conditional Column",{{"Data.Column3", "Description"}}),
		    
		    // Add index for transaction grouping
		    #"Added Index" = Table.AddIndexColumn(#"Renamed Columns", "Index", 0, 1),
		    
		    // Mark actual transactions (rows with dates and amounts)
		    #"Added Transaction Group" = Table.AddColumn(#"Added Index", "TransactionGroup", each 
		        if [Amount] <> null or [Description] <> "" then [Index] else null, type number),
		    
		    // Fill down transaction groups to group related rows
		    #"Filled Transaction Groups" = Table.FillDown(#"Added Transaction Group", {"TransactionGroup"}),
		    
		    // Remove rows with errors in critical columns
		    #"Removed Errors" = Table.RemoveRowsWithErrors(#"Filled Transaction Groups", {"TransactionGroup", "Amount", "Date"}),
		    
		    // Group by transaction to combine descriptions
		    #"Grouped Transactions" = Table.Group(#"Removed Errors", {"TransactionGroup", "Date", "Amount"}, {
		        {"Description", each Text.Combine(List.RemoveNulls(List.Transform(Table.Column(_, "Description"), each if _ = "" then null else _)), " "), type text},
		        {"PageRef", each Text.Combine(List.RemoveNulls(List.Distinct(Table.Column(_, "PageNum"))), ","), type text}
		    }),
		    
		    // Remove null or empty descriptions
		    #"Filtered Rows" = Table.SelectRows(#"Grouped Transactions", each [Description] <> null and [Description] <> ""),
		    
		    // Remove the TransactionGroup column and sort by date
		    #"Removed Columns" = Table.RemoveColumns(#"Filtered Rows", {"TransactionGroup"}),
		    
		    // Clean up descriptions (remove null text and excessive spaces)
		    #"Cleaned Descriptions" = Table.TransformColumns(#"Removed Columns", {
		        {"Description", each 
		            try
		                Text.Trim(Text.Replace(Text.Replace(Text.From(_ ?? ""), "null", ""), "  ", " "))
		            otherwise
		                "", type text}
		    }),
		    
		    // Filter out rows without dates or amounts
		    #"Filtered Valid Transactions" = Table.SelectRows(#"Cleaned Descriptions", each [Date] <> null and [Amount] <> null),
		    
		    // Sort by date
		    #"Sorted Rows" = Table.Sort(#"Filtered Valid Transactions", {{"Date", Order.Ascending}}),
		    
		    // Add month and year columns for easier analysis
		    #"Added Month" = Table.AddColumn(#"Sorted Rows", "Month", each try Date.Month([Date]) otherwise null, Int64.Type),
		    #"Added Year" = Table.AddColumn(#"Added Month", "Year", each try Date.Year([Date]) otherwise null, Int64.Type),
		    
		    // Categorize as debit or credit
		    #"Added Category" = Table.AddColumn(#"Added Year", "Category", each 
		        try
		            if [Amount] < 0 then "Debit" else "Credit"
		        otherwise
		            "Unknown", type text),
		    // Add absolute amount column for easier analysis
		    #"Added Absolute Amount" = Table.AddColumn(#"Added Category", "AbsoluteAmount", each 
		        try
		            Number.Abs([Amount])
		        otherwise
		            null, type number),
		    
		    // Final column reordering
		    #"Reordered Columns" = Table.ReorderColumns(#"Added Absolute Amount", {"Date", "Description", "Amount", "AbsoluteAmount", "Category", "Month", "Year", "PageRef"}),
		    #"Changed Type" = Table.TransformColumnTypes(#"Reordered Columns",{{"Amount", type number}})
		in
		    #"Changed Type"
		```
