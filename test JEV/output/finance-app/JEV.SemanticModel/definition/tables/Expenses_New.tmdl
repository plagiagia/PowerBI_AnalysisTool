		lineageTag: 5b6e8137-d80e-4968-9a76-dd2cdab9f171

	measure 'Total Expenses Clean' = CALCULATE([Total absolute expenses], Expenses_New[Category]="Debit")
		formatString: "€"\ #,0.0;-"€"\ #,0.0;"€"\ #,0.0
		lineageTag: 995677f0-2e9f-4260-ac73-5a0d9b76af83

	measure 'Total Income Clean' = CALCULATE([Total absolute expenses], Expenses_New[Category]="Credit")
		formatString: "€"\ #,0.0;-"€"\ #,0.0;"€"\ #,0.0
		lineageTag: d6374370-6e14-4b89-b9ff-1fff59f41b14

	measure 'Income Run Out' = ```
			
			// Get current row date context
			VAR CurrentDate = MAX(Expenses_New[Date])
			
			// Find the previous payday
			VAR PreviousPayday = 
			    CALCULATE(
			        MAX(Expenses_New[Date]),
			        FILTER(
			            ALL(Expenses_New),
			            Expenses_New[Date] <= CurrentDate &&
			            Expenses_New[Description] = "Gehalt/Rente BASF SERVICES EUROPE GMBH" &&
			            Expenses_New[Category] = "Credit"
			        )
			    )
			
			// Calculate income since previous payday to current date
			VAR IncomeToDate = 
			    CALCULATE(
			        SUM(Expenses_New[Amount]), // Replace with your actual amount column
			        FILTER(
			            ALL(Expenses_New),
			            Expenses_New[Date] >= PreviousPayday &&
			            Expenses_New[Date] <= CurrentDate &&
			            Expenses_New[Category] = "Credit"
			        )
			    )
			
			// Calculate expenses since previous payday to current date
			VAR ExpensesToDate = 
			    CALCULATE(
			        SUM(Expenses_New[Amount]), // Replace with your actual amount column
			        FILTER(
			            ALL(Expenses_New),
			            Expenses_New[Date] >= PreviousPayday &&
			            Expenses_New[Date] <= CurrentDate &&
			            Expenses_New[Category] = "Debit"
			        )
			    )
			
			// Return the running balance
			RETURN
			    IF(
			        ISBLANK(PreviousPayday),
			        BLANK(),
			        IncomeToDate - ExpensesToDate
			    )
			```
		lineageTag: 09059ebe-c32b-4700-a6df-9080b80e5a7e

