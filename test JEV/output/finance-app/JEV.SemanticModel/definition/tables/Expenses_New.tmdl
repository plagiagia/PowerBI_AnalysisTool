		formatString: "€"\ #,0.0;-"€"\ #,0.0;"€"\ #,0.0
		lineageTag: 90736f80-9042-45d7-8d5c-bfb4aaf80217

	measure 'Total absolute expenses' = SUM(Expenses_New[AbsoluteAmount])
